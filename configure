#!/bin/sh

# Configure the R package against Homebrew's s2geometry CMake package. CMake
# resolves S2's transitive Abseil dependencies and records the complete link
# interface for use by R's Makevars.

set -eu

if test -z "${CMAKE:-}"; then
  CMAKE=`command -v cmake || true`
fi

if test -z "${CMAKE}"; then
  echo "--------------------------- [ANTICONF] --------------------------------"
  echo "Configuration failed because cmake was not found."
  echo "Install it with: brew install cmake"
  echo "------------------------------------------------------------------------"
  exit 1
fi

if test -z "${BREW:-}"; then
  BREW=`command -v brew || true`
fi

if test -z "${BREW}" || ! S2_PREFIX=`"${BREW}" --prefix s2geometry 2>/dev/null`; then
  echo "--------------------------- [ANTICONF] --------------------------------"
  echo "Configuration failed because Homebrew s2geometry was not found."
  echo "Install it with: brew install s2geometry"
  echo "------------------------------------------------------------------------"
  exit 1
fi

BUILD_DIR="`pwd`/tools/build"

if test -n "${R_HOME:-}"; then
  R_EXECUTABLE="${R_HOME}/bin/R"
else
  R_EXECUTABLE=`command -v R || true`
fi

if test -z "${R_EXECUTABLE}"; then
  echo "Configuration failed because R was not found."
  exit 1
fi

R_CXX17=`"${R_EXECUTABLE}" CMD config CXX17`

echo "** Configuring s2geography with Homebrew s2geometry at ${S2_PREFIX}"
if ! CXX="${R_CXX17}" "${CMAKE}" -S . -B "${BUILD_DIR}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_PREFIX_PATH="${S2_PREFIX}" >configure.log 2>&1; then
  echo "** CMake configuration failed"
  cat configure.log
  exit 1
fi

if ! "${CMAKE}" --build "${BUILD_DIR}" --config Release \
    --target linker_flags >>configure.log 2>&1; then
  echo "** CMake build failed"
  cat configure.log
  exit 1
fi

LINK_FLAGS_FILE="${BUILD_DIR}/linker_flags.txt"
INCLUDE_FLAGS_FILE="${BUILD_DIR}/s2_include_flags.txt"

if test ! -s "${LINK_FLAGS_FILE}" || test ! -s "${INCLUDE_FLAGS_FILE}"; then
  echo "** CMake did not produce the expected compiler and linker flags"
  cat configure.log
  exit 1
fi

PKG_LIBS=`sed "s|libs2geography\\.a|${BUILD_DIR}/libs2geography.a|" "${LINK_FLAGS_FILE}"`
PKG_CFLAGS=`cat "${INCLUDE_FLAGS_FILE}"`

echo "** Using PKG_CPPFLAGS=${PKG_CFLAGS}"
echo "** Using PKG_LIBS=${PKG_LIBS}"

sed \
  -e "s|@cflags@|${PKG_CFLAGS}|g" \
  -e "s|@libs@|${PKG_LIBS}|g" \
  -e "s|@cmake_build@|${BUILD_DIR}|g" \
  src/Makevars.in >src/Makevars

exit 0
