#!/bin/sh

# Configure the R package against s2geometry from Homebrew or vcpkg. CMake
# resolves S2's transitive dependencies and records the complete link interface
# for use by R's Makevars.

set -eu

if test -z "${CMAKE:-}"; then
  CMAKE=`command -v cmake || true`
fi

if test -z "${CMAKE}"; then
  echo "--------------------------- [ANTICONF] --------------------------------"
  echo "Configuration failed because cmake was not found."
  echo "Install CMake with your system package manager."
  echo "------------------------------------------------------------------------"
  exit 1
fi

if test -n "${R_HOME:-}"; then
  R_EXECUTABLE="${R_HOME}/bin/R"
else
  R_EXECUTABLE=`command -v R || true`
fi

if test -z "${R_EXECUTABLE}"; then
  echo "Configuration failed because R was not found."
  exit 1
fi

BUILD_DIR="`pwd`/tools/build"
OVERLAY_TRIPLETS="`pwd`/tools/vcpkg-triplets"
SYSTEM_NAME=`uname -s`
SYSTEM_ARCH=`uname -m`

# Use R's complete toolchain for both this project and dependencies that vcpkg
# builds. The overlay triplets forward these variables into vcpkg's clean build
# environment and include them in its binary-cache ABI calculation.
CC=`"${R_EXECUTABLE}" CMD config CC`
CXX=`"${R_EXECUTABLE}" CMD config CXX`
CPPFLAGS=`"${R_EXECUTABLE}" CMD config CPPFLAGS`
CFLAGS=`"${R_EXECUTABLE}" CMD config CFLAGS`
CXXFLAGS=`"${R_EXECUTABLE}" CMD config CXXFLAGS`
LDFLAGS=`"${R_EXECUTABLE}" CMD config LDFLAGS`
export CC CXX CPPFLAGS CFLAGS CXXFLAGS LDFLAGS

CMAKE_TOOLCHAIN_FILE_VALUE="${CMAKE_TOOLCHAIN_FILE:-}"
CMAKE_PREFIX_PATH_VALUE="${CMAKE_PREFIX_PATH:-}"
VCPKG_TARGET_TRIPLET_VALUE="${VCPKG_TARGET_TRIPLET:-${VCPKG_DEFAULT_TRIPLET:-}}"
VCPKG_OVERLAY_TRIPLETS_VALUE="${VCPKG_OVERLAY_TRIPLETS:-}"
VCPKG_MANIFEST_MODE_VALUE="${VCPKG_MANIFEST_MODE:-ON}"

if test -n "${VCPKG_ROOT:-}"; then
  if test ! -f "${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake" || \
      test ! -x "${VCPKG_ROOT}/vcpkg"; then
    echo "--------------------------- [ANTICONF] --------------------------------"
    echo "VCPKG_ROOT does not point to a bootstrapped vcpkg checkout:"
    echo "  ${VCPKG_ROOT}"
    echo "------------------------------------------------------------------------"
    exit 1
  fi

  if test -z "${CMAKE_TOOLCHAIN_FILE_VALUE}"; then
    CMAKE_TOOLCHAIN_FILE_VALUE="${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
  fi

  if test -z "${VCPKG_TARGET_TRIPLET_VALUE}"; then
    case "${SYSTEM_NAME}:${SYSTEM_ARCH}" in
      Darwin:arm64|Darwin:aarch64)
        VCPKG_TARGET_TRIPLET_VALUE="r-s2-arm64-osx"
        ;;
      Darwin:x86_64|Darwin:amd64)
        VCPKG_TARGET_TRIPLET_VALUE="r-s2-x64-osx"
        ;;
      Linux:arm64|Linux:aarch64)
        VCPKG_TARGET_TRIPLET_VALUE="r-s2-arm64-linux"
        ;;
      Linux:x86_64|Linux:amd64)
        VCPKG_TARGET_TRIPLET_VALUE="r-s2-x64-linux"
        ;;
      *)
        echo "No default vcpkg triplet for ${SYSTEM_NAME} ${SYSTEM_ARCH}."
        echo "Set VCPKG_TARGET_TRIPLET to an appropriate overlay triplet."
        exit 1
        ;;
    esac
  fi

  if test -n "${VCPKG_OVERLAY_TRIPLETS_VALUE}"; then
    VCPKG_OVERLAY_TRIPLETS_VALUE="${OVERLAY_TRIPLETS};${VCPKG_OVERLAY_TRIPLETS_VALUE}"
  else
    VCPKG_OVERLAY_TRIPLETS_VALUE="${OVERLAY_TRIPLETS}"
  fi

  echo "** Configuring s2geography with vcpkg triplet ${VCPKG_TARGET_TRIPLET_VALUE}"
else
  if test "${SYSTEM_NAME}" != "Darwin"; then
    echo "--------------------------- [ANTICONF] --------------------------------"
    echo "Building on ${SYSTEM_NAME} requires VCPKG_ROOT to point to a"
    echo "bootstrapped vcpkg checkout."
    echo "------------------------------------------------------------------------"
    exit 1
  fi

  if test -z "${BREW:-}"; then
    BREW=`command -v brew || true`
  fi

  if test -z "${BREW}" || ! S2_PREFIX=`"${BREW}" --prefix s2geometry 2>/dev/null`; then
    echo "--------------------------- [ANTICONF] --------------------------------"
    echo "Configuration failed because Homebrew s2geometry was not found."
    echo "Install it with: brew install s2geometry"
    echo "Alternatively, set VCPKG_ROOT to a bootstrapped vcpkg checkout."
    echo "------------------------------------------------------------------------"
    exit 1
  fi

  if test -n "${CMAKE_PREFIX_PATH_VALUE}"; then
    CMAKE_PREFIX_PATH_VALUE="${CMAKE_PREFIX_PATH_VALUE};${S2_PREFIX}"
  else
    CMAKE_PREFIX_PATH_VALUE="${S2_PREFIX}"
  fi

  echo "** Configuring s2geography with Homebrew s2geometry at ${S2_PREFIX}"
fi

# Build the CMake argument vector incrementally so paths and user-provided
# values containing spaces remain single arguments.
set -- \
  -S tools \
  -B "${BUILD_DIR}" \
  -DCMAKE_BUILD_TYPE=Release

if test -n "${CMAKE_TOOLCHAIN_FILE_VALUE}"; then
  set -- "$@" "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE_VALUE}"
fi
if test -n "${CMAKE_PREFIX_PATH_VALUE}"; then
  set -- "$@" "-DCMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH_VALUE}"
fi
if test -n "${VCPKG_TARGET_TRIPLET_VALUE}"; then
  set -- "$@" "-DVCPKG_TARGET_TRIPLET=${VCPKG_TARGET_TRIPLET_VALUE}"
fi
if test -n "${VCPKG_OVERLAY_TRIPLETS_VALUE}"; then
  set -- "$@" "-DVCPKG_OVERLAY_TRIPLETS=${VCPKG_OVERLAY_TRIPLETS_VALUE}"
fi
if test -n "${VCPKG_MANIFEST_MODE_VALUE}"; then
  set -- "$@" "-DVCPKG_MANIFEST_MODE=${VCPKG_MANIFEST_MODE_VALUE}"
fi

if ! "${CMAKE}" "$@" >configure.log 2>&1; then
  echo "** CMake configuration failed"
  cat configure.log
  exit 1
fi

if ! "${CMAKE}" --build "${BUILD_DIR}" --config Release \
    --target linker_flags >>configure.log 2>&1; then
  echo "** CMake build failed"
  cat configure.log
  exit 1
fi

LINK_FLAGS_FILE="${BUILD_DIR}/linker_flags.txt"
INCLUDE_FLAGS_FILE="${BUILD_DIR}/s2_include_flags.txt"

if test ! -s "${LINK_FLAGS_FILE}" || test ! -s "${INCLUDE_FLAGS_FILE}"; then
  echo "** CMake did not produce the expected compiler and linker flags"
  cat configure.log
  exit 1
fi

PKG_LIBS=`sed \
  -e "s|libs2geography\\.a|${BUILD_DIR}/libs2geography.a|" \
  -e "s|^vcpkg_installed/|${BUILD_DIR}/vcpkg_installed/|" \
  -e "s| vcpkg_installed/| ${BUILD_DIR}/vcpkg_installed/|g" \
  "${LINK_FLAGS_FILE}"`
PKG_CFLAGS=`cat "${INCLUDE_FLAGS_FILE}"`

echo "** Using PKG_CPPFLAGS=${PKG_CFLAGS}"
echo "** Using PKG_LIBS=${PKG_LIBS}"

sed \
  -e "s|@cflags@|${PKG_CFLAGS}|g" \
  -e "s|@libs@|${PKG_LIBS}|g" \
  -e "s|@cmake_build@|${BUILD_DIR}|g" \
  src/Makevars.in >src/Makevars

exit 0
